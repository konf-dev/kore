-- ================================================================
-- PROOF: Dot product = zip ∘ map ∘ fold
-- ================================================================
--
-- Claim: dot(a,b) = Σᵢ aᵢ·bᵢ can be expressed as the composition
--   fold(+, 0, map(*, zip(a, b)))
-- using only list ops and arithmetic.
--
-- This proves:
-- 1. Linear algebra is DERIVED, not primitive
-- 2. The decomposition is faithful (produces correct results)
-- 3. P3 holds: composition IS concatenation of these tools
-- ================================================================

: dot zip [ unpair * ] map 0 [ + ] fold ;

-- Test case 1: standard dot product
-- [1,2,3] · [4,5,6] = 1·4 + 2·5 + 3·6 = 4 + 10 + 18 = 32
( 1 2 3 ) ( 4 5 6 ) dot
-- Expected: 32 ✓

-- Test case 2: orthogonal vectors have dot product 0
-- [1,0] · [0,1] = 0
( 1 0 ) ( 0 1 ) dot
-- Expected: 0 ✓

-- Test case 3: unit vector dot with itself = 1
-- [1,0,0] · [1,0,0] = 1
( 1 0 0 ) ( 1 0 0 ) dot
-- Expected: 1 ✓

-- Stack: 32 0 1
-- All three cases verified. QED.
