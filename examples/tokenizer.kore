# Kore Tokenizer - Written in Kore
# 
# Tokenizes Kore source into token maps.
# Usage: "5 3 add" tokenize
# Result: [{type: "WORD", value: "5"}, {type: "WORD", value: "3"}, {type: "WORD", value: "add"}]

# is-space: (char -- bool)
"is-space" [dup " " eq over "\n" eq or over "\t" eq or swap "\r" eq or] def

# skip-spaces: (source -- source)
"skip-spaces" [
    [dup str-len 0 gt [dup 0 str-get is-space] [false] if]
    [1 999999 str-slice]
    while
] def

# read-word: (source -- source word)
"read-word" [
    "" swap   
    [dup str-len 0 gt [dup 0 str-get dup is-space not over "[" eq not and swap "]" eq not and] [false] if]
    [dup 0 str-get rot swap str-concat swap 1 999999 str-slice]
    while
    swap  
] def

# make-token: (type value -- token)
"make-token" [map-empty swap "value" swap map-set swap "type" swap map-set] def

# tokenize: (source -- tokens)
# Stack discipline: [tokens source]
"tokenize" [
    list-empty swap
    
    [dup str-len 0 gt]
    [
        skip-spaces
        dup str-len 0 gt
        [
            dup 0 str-get
            
            dup "[" eq
            [
                drop 1 999999 str-slice
                swap "LBRACKET" "[" make-token list-push swap
            ]
            [
                dup "]" eq
                [
                    drop 1 999999 str-slice
                    swap "RBRACKET" "]" make-token list-push swap
                ]
                [
                    drop read-word
                    # Stack: source word
                    "WORD" swap make-token
                    # Stack: source token
                    rot swap list-push swap
                ]
                if
            ]
            if
        ]
        []
        if
    ]
    while
    
    drop
] def

# Test
"hello world" tokenize
