# Kore Prelude
# Essential composed tools loaded by default.
#
# These tools are composed from the ~50 core primitives.
# There's no magic - they're just programs.

# ============================================================
# STACK COMBINATORS
# ============================================================

# dupd: duplicate second item (a b -- a a b)
[ swap dup rot ] "dupd" def

# nip2: remove top two items (a b c -- a)
[ drop drop ] "nip2" def

# 2dup: duplicate top pair (a b -- a b a b)
[ over over ] "2dup" def

# 2drop: drop top pair (a b -- )
[ drop drop ] "2drop" def

# 2swap: swap top two pairs (a b c d -- c d a b)
[ rot [ rot ] dip ] "2swap" def

# keep: apply quote and keep value (a q -- ... a)
[ over [ call ] dip ] "keep" def

# bi: apply two quotes to same value (a q1 q2 -- r1 r2)
[ [ keep ] dip call ] "bi" def

# tri: apply three quotes to same value (a q1 q2 q3 -- r1 r2 r3)
[ [ [ keep ] dip keep ] dip call ] "tri" def

# ============================================================
# BOOLEAN
# ============================================================

# true constant
[ 1 0 eq not ] "true" def

# false constant
[ 1 0 eq ] "false" def

# bool: convert to boolean
[ [ true ] [ false ] if ] "bool" def

# ============================================================
# COMPARISON OPERATORS
# (Composed from primitives: eq, lt)
# ============================================================

# gt: greater than (a b -- bool)
[ swap lt ] "gt" def

# le: less-than-or-equal (a b -- bool)
[ 2dup lt [ 2drop true ] [ eq ] if ] "le" def

# ge: greater-than-or-equal (a b -- bool)
[ swap le ] "ge" def

# ne: not equal (a b -- bool)
[ eq not ] "ne" def

# neq: alias for ne
[ ne ] "neq" def

# ============================================================
# ARITHMETIC HELPERS
# ============================================================

# inc: increment by 1
[ 1 add ] "inc" def

# dec: decrement by 1
[ 1 sub ] "dec" def

# zero?: is it zero?
[ 0 eq ] "zero?" def

# pos?: is it positive?
[ 0 gt ] "pos?" def

# neg?: is it negative?
[ 0 lt ] "neg?" def

# even?: is it even?
[ 2 mod 0 eq ] "even?" def

# odd?: is it odd?
[ 2 mod 0 ne ] "odd?" def

# square: x^2
[ dup mul ] "square" def

# cube: x^3
[ dup dup mul mul ] "cube" def

# ============================================================
# COMPARISON HELPERS
# ============================================================

# between?: (x lo hi -- bool) is x in [lo, hi]?
[ rot dup rot ge [ swap le ] dip and ] "between?" def

# clamp: (x lo hi -- x') clamp x to [lo, hi]
[ rot min max ] "clamp" def

# ============================================================
# CONTROL FLOW
# ============================================================

# when: conditional execution (cond q -- )
# Runs q only if cond is true
[ swap [ call ] [ drop ] if ] "when" def

# unless: negative conditional (cond q -- )
# Runs q only if cond is false
[ swap [ drop ] [ call ] if ] "unless" def

# Note: times and while are native tools with special stack semantics

# ============================================================
# LIST BASICS (composed from core)
# ============================================================

# collect: alias for list (n -- list)
[ list ] "collect" def

# list-empty: create empty list ( -- list)
[ 0 list ] "list-empty" def

# to-list: wrap single value in list (a -- [a])
[ 1 list ] "to-list" def

# empty?: is list empty?
[ 0 list eq ] "empty?" def

# singleton: make single-element list (a -- [a])
[ 1 list ] "singleton" def

# pair: make two-element list (a b -- [a b])
[ 2 list ] "pair" def

# triple: make three-element list (a b c -- [a b c])
[ 3 list ] "triple" def

# first: get first element (list -- elem)
[ 0 list-get ] "first" def

# second: get second element (list -- elem)
[ 1 list-get ] "second" def

# third: get third element (list -- elem)
[ 2 list-get ] "third" def

# last: get last element (list -- elem)
[ dup list-len 1 sub list-get ] "last" def

# ============================================================
# MAP BASICS (composed from core)
# ============================================================

# map-empty: alias for map-new ( -- map)
[ map-new ] "map-empty" def

# has-key?: check if map has key (map key -- bool)
[ swap map-get null eq not ] "has-key?" def

# ============================================================
# ERROR HELPERS
# ============================================================

# error?: is it an error?
[ is-error ] "error?" def

# ok?: is it not an error?
[ is-error not ] "ok?" def

# assert: fail if condition is false (cond msg -- )
[ swap not [ fail ] when drop ] "assert" def
