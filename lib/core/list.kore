# List helpers - utilities for list manipulation
# Each tool does ONE thing.

# list-first: (list -- item)
# Get first element
"list-first" [0 list-get] def

# list-last: (list -- item)
# Get last element  
"list-last" [dup list-len 1 sub list-get] def

# list-rest: (list -- list)
# Get all but first element
"list-rest" [1 swap list-len list-slice] def

# list-init: (list -- list)
# Get all but last element
"list-init" [dup list-len 1 sub 0 swap list-slice] def

# list-empty: ( -- list)
# Create empty list
"list-empty" [0 list] def

# list-contains: (list item -- bool)
# Check if list contains item using fold
"list-contains" [
    swap                    # item list
    false                   # item list false
    rot rot                 # false item list
    swap                    # false list item
    [                       # predicate: (acc elem -- acc')
        rot                 # elem acc item
        over over eq        # elem acc item (elem==item)
        rot or              # elem item (acc || elem==item)
        swap drop           # item new_acc
        swap                # new_acc item
    ] fold
    swap drop               # result
] def
