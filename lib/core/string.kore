# String helpers - small utilities for string manipulation
# Each tool does ONE thing.

# is-space: (char -- bool)
# Check if character is whitespace
"is-space" [
    dup " " eq
    over "\n" eq or
    over "\t" eq or
    swap "\r" eq or
] def

# is-digit: (char -- bool)
# Check if character is 0-9
"is-digit" [
    char-code
    dup 48 lt not         # >= '0' (i.e., NOT < 48)
    swap 57 swap lt not   # <= '9' (i.e., NOT 57 < code)
    and
] def

# is-alpha: (char -- bool)
# Check if character is a-z or A-Z
"is-alpha" [
    char-code
    dup dup 65 lt not swap 90 swap lt not and   # A-Z: code >= 65 AND code <= 90
    swap dup 97 lt not swap 122 swap lt not and # a-z: code >= 97 AND code <= 122
    or
] def

# is-alnum: (char -- bool)
# Check if character is alphanumeric
"is-alnum" [
    dup is-digit
    swap is-alpha
    or
] def
