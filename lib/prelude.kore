# Kore Prelude - standard library loaded at boot
#
# This file is automatically loaded when the REPL starts.
# It defines useful words built from primitives.
#
# Philosophy: Each word does one thing, clearly.
#
# Syntax: "name" [body] def

# -- Stack utilities --

# nip: (a b -- b) - drop second item
"nip" [swap drop] def

# tuck: (a b -- b a b) - copy top under second
"tuck" [swap over] def

# 2drop: (a b -- ) - drop top two
"2drop" [drop drop] def

# -- List creation --

# list1: (a -- [a]) - single item list
"list1" [1 swap list] def

# list2: (a b -- [a b]) - two item list  
"list2" [2 rot rot list] def

# -- Arithmetic --

# inc: (n -- n+1)
"inc" [1 add] def

# dec: (n -- n-1)
"dec" [1 sub] def

# square: (n -- n*n)
"square" [dup mul] def

# abs: (n -- |n|) - absolute value
"abs" [dup 0 lt [ neg ] [ ] if] def

# max: (a b -- max) - larger of two
# Note: a > b is (a b swap lt)
"max" [over over swap lt [ drop ] [ nip ] if] def

# min: (a b -- min) - smaller of two  
"min" [over over lt [ drop ] [ nip ] if] def

# -- String --

# empty-str?: (s -- b) - check if string is empty
"empty-str?" [str-len 0 eq] def

# -- List --

# empty-list?: (l -- b) - check if list is empty  
"empty-list?" [list-len 0 eq] def

# first: (l -- item) - get first item
"first" [0 list-get] def

# last: (l -- item) - get last item
"last" [dup list-len 1 sub list-get] def

# rest: (l -- l') - all but first
"rest" [dup list-len 1 swap list-slice] def

# -- Higher-order --

# sum: (l -- n) - sum of list
"sum" [0 [add] fold] def

# product: (l -- n) - product of list
"product" [1 [mul] fold] def

# -- Logging --

# log-debug: (msg -- ) - debug log
"log-debug" ["debug" swap log] def

# log-info: (msg -- ) - info log
"log-info" ["info" swap log] def

# log-warn: (msg -- ) - warning log
"log-warn" ["warn" swap log] def

# log-error: (msg -- ) - error log
"log-error" ["error" swap log] def

# -- Assertions --

# assert-eq: (a b msg -- ) - assert equal, fail with msg if not
"assert-eq" [rot rot eq [ drop ] [ fail ] if] def

# assert-neq: (a b msg -- ) - assert not equal, fail with msg if equal
"assert-neq" [rot rot eq [ fail ] [ drop ] if] def

# assert-not-null: (v msg -- ) - assert value is not null
"assert-not-null" [swap is-null [ fail ] [ drop ] if] def

# -- System info --

# sys-info: ( -- map) - get system information
"sys-info" [
    map-new
    "pid" pid map-set
    "cwd" cwd map-set
    "tool-count" words list-len map-set
] def

