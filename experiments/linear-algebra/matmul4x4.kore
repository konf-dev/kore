-- ================================================================
-- 4×4 Matrix Multiply: A² where A = [[1..4],[5..8],[9..12],[13..16]]
-- ================================================================
-- Pure composition (P3): each C[i][j] = Σ_k A[i][k] * A[k][j]
-- No matrix primitive. No random access. Just arithmetic.
-- 16 dot products × 4 elements each = 64 multiplications.
-- ================================================================

-- Row 0: A[0] = [1, 2, 3, 4]
-- C[0][0] = 1*1 + 2*5 + 3*9 + 4*13
1 1 * 2 5 * + 3 9 * + 4 13 * +    -- 90
-- C[0][1] = 1*2 + 2*6 + 3*10 + 4*14
1 2 * 2 6 * + 3 10 * + 4 14 * +   -- 100
-- C[0][2] = 1*3 + 2*7 + 3*11 + 4*15
1 3 * 2 7 * + 3 11 * + 4 15 * +   -- 110
-- C[0][3] = 1*4 + 2*8 + 3*12 + 4*16
1 4 * 2 8 * + 3 12 * + 4 16 * +   -- 120

-- Row 1: A[1] = [5, 6, 7, 8]
-- C[1][0] = 5*1 + 6*5 + 7*9 + 8*13
5 1 * 6 5 * + 7 9 * + 8 13 * +    -- 202
-- C[1][1] = 5*2 + 6*6 + 7*10 + 8*14
5 2 * 6 6 * + 7 10 * + 8 14 * +   -- 228
-- C[1][2] = 5*3 + 6*7 + 7*11 + 8*15
5 3 * 6 7 * + 7 11 * + 8 15 * +   -- 254
-- C[1][3] = 5*4 + 6*8 + 7*12 + 8*16
5 4 * 6 8 * + 7 12 * + 8 16 * +   -- 280

-- Row 2: A[2] = [9, 10, 11, 12]
-- C[2][0] = 9*1 + 10*5 + 11*9 + 12*13
9 1 * 10 5 * + 11 9 * + 12 13 * +    -- 314
-- C[2][1] = 9*2 + 10*6 + 11*10 + 12*14
9 2 * 10 6 * + 11 10 * + 12 14 * +   -- 356
-- C[2][2] = 9*3 + 10*7 + 11*11 + 12*15
9 3 * 10 7 * + 11 11 * + 12 15 * +   -- 398
-- C[2][3] = 9*4 + 10*8 + 11*12 + 12*16
9 4 * 10 8 * + 11 12 * + 12 16 * +   -- 440

-- Row 3: A[3] = [13, 14, 15, 16]
-- C[3][0] = 13*1 + 14*5 + 15*9 + 16*13
13 1 * 14 5 * + 15 9 * + 16 13 * +    -- 426
-- C[3][1] = 13*2 + 14*6 + 15*10 + 16*14
13 2 * 14 6 * + 15 10 * + 16 14 * +   -- 484
-- C[3][2] = 13*3 + 14*7 + 15*11 + 16*15
13 3 * 14 7 * + 15 11 * + 16 15 * +   -- 542
-- C[3][3] = 13*4 + 14*8 + 15*12 + 16*16
13 4 * 14 8 * + 15 12 * + 16 16 * +   -- 600

-- Stack (bottom to top): 90 100 110 120 202 228 254 280 314 356 398 440 426 484 542 600
-- = A² = [[90,100,110,120],[202,228,254,280],[314,356,398,440],[426,484,542,600]]
-- QED: 4×4 matmul derived from P1 arithmetic + P3 composition.
