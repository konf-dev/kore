    "react-scripts": "5.0.1",
    "react-router-dom": "^6.x.x",
    "@mui/material": "^5.x.x",
    "@emotion/react": "^11.x.x",
    "@emotion/styled": "^11.x.x",
    "chart.js": "^4.x.x",
    "react-chartjs-2": "^5.x.x",
    "recharts": "^2.x.x",
    "@reduxjs/toolkit": "^1.9.x",
    "react-redux": "^8.x.x",
    "axios": "^1.x.x",
    "@tanstack/react-query": "^4.x.x",
    "socket.io-client": "^4.x.x",
