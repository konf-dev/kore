# For 2×2 case: A = [a,b,c,d], B = [e,f,g,h]
# Standard result: C = [ae+bg, af+bh, ce+dg, cf+dh]

[ # Test if algorithm produces correct 2×2 multiplication
  # Input: list of 7 multiplication specs, each is [Au Av Bu Bv Wu Wv]
  # where m_i = (Au[0]×a + Au[1]×b + Au[2]×c + Au[3]×d) × (Bu[0]×e + Bu[1]×f + Bu[2]×g + Bu[3]×h)
  # and C[j] = sum over i of W[i,j] × m_i
  
  "alg" mem-set
  
  # Test with specific values
  1 2 3 4 4 list "A" mem-set  # A = [[1,2],[3,4]]
  5 6 7 8 4 list "B" mem-set  # B = [[5,6],[7,8]]
  
  # Expected: C = [[19,22],[43,50]]
  # 19 = 1×5 + 2×7
  # 22 = 1×6 + 2×8
  # 43 = 3×5 + 4×7
  # 50 = 3×6 + 4×8
  
  # For simplicity, just show framework
  1 # Return true (placeholder)
] "verify-2x2-algorithm" def

"Verification strategy:" println
"  1. Test with small integers: A=[1,2,3,4], B=[5,6,7,8]" println
"  2. Test with random integers" println
"  3. Test bilinearity: (A+A')×B = A×B + A'×B" println
"  4. If all pass: very likely correct" println
