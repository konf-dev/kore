"[6] Fiber Checkpointing:" print
"" print
"    Kore fibers enable:" print
"      - Pause long-running search" print
"      - Save state via fiber-yield" print
"      - Resume later with fiber-resume" print
"" print
"    Use case: Search for hours, checkpoint, resume" print
"" print

# Demo: simple counter with manual checkpointing
0 "counter" mem-set

"    Demo: counting with checkpoints..." print
"counter" mem-get 1 add "counter" mem-set
"counter" mem-get 1 add "counter" mem-set
"counter" mem-get 1 add "counter" mem-set
"counter" mem-get 1 add "counter" mem-set
"counter" mem-get 1 add "counter" mem-set
"    [checkpoint] counter = " print "counter" mem-get to-text print
"counter" mem-get 1 add "counter" mem-set
"counter" mem-get 1 add "counter" mem-set
"counter" mem-get 1 add "counter" mem-set
"counter" mem-get 1 add "counter" mem-set
"counter" mem-get 1 add "counter" mem-set
"    [final] counter = " print "counter" mem-get to-text print
"" print

