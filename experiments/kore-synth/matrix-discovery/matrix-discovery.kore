# MATRIX MULTIPLICATION DISCOVERY FRAMEWORK
# Goal: Find algorithms with fewer multiplications than standard O(n³)
#
# Standard 2×2: 8 multiplications
# Strassen 2×2: 7 multiplications (discovered 1969)
# 
# This framework attempts to rediscover Strassen and potentially find new algorithms

"" println
"╔══════════════════════════════════════════════════════════════════╗" println
"║  MATRIX MULTIPLICATION DISCOVERY                                 ║" println
"║  Searching for algorithms with minimal multiplications           ║" println
"╚══════════════════════════════════════════════════════════════════╝" println
"" println

# ====================================================================
# MATRIX REPRESENTATION
# ====================================================================
# A 2×2 matrix [[a,b],[c,d]] is stored as a flat list [a,b,c,d]
# Indices: [0]=a  [1]=b
#          [2]=c  [3]=d

# Standard 2×2 matrix multiplication
# C = A × B where:
# c00 = a00*b00 + a01*b10
# c01 = a00*b01 + a01*b11  
# c10 = a10*b00 + a11*b10
# c11 = a10*b01 + a11*b11
# Uses 8 multiplications

[ # ( A B -- C )  Standard algorithm
  "B" mem-set "A" mem-set
  
  # c00 = a00*b00 + a01*b10
  "A" mem-get 0 list-get "B" mem-get 0 list-get mul
  "A" mem-get 1 list-get "B" mem-get 2 list-get mul add
  
  # c01 = a00*b01 + a01*b11
  "A" mem-get 0 list-get "B" mem-get 1 list-get mul
  "A" mem-get 1 list-get "B" mem-get 3 list-get mul add
  
  # c10 = a10*b00 + a11*b10
  "A" mem-get 2 list-get "B" mem-get 0 list-get mul
  "A" mem-get 3 list-get "B" mem-get 2 list-get mul add
  
  # c11 = a10*b01 + a11*b11
  "A" mem-get 2 list-get "B" mem-get 1 list-get mul
  "A" mem-get 3 list-get "B" mem-get 3 list-get mul add
  
  4 list
] "mat2-mul-standard" def

# Strassen's algorithm (7 multiplications)
# M1 = (a00 + a11) * (b00 + b11)
# M2 = (a10 + a11) * b00
# M3 = a00 * (b01 - b11)
# M4 = a11 * (b10 - b00)
# M5 = (a00 + a01) * b11
# M6 = (a10 - a00) * (b00 + b01)
# M7 = (a01 - a11) * (b10 + b11)
#
# C00 = M1 + M4 - M5 + M7
# C01 = M3 + M5
# C10 = M2 + M4
# C11 = M1 - M2 + M3 + M6

[ # ( A B -- C )  Strassen algorithm - 7 multiplications
  "B" mem-set "A" mem-set
  
  # Extract elements for readability
  "A" mem-get 0 list-get "a00" mem-set
  "A" mem-get 1 list-get "a01" mem-set
  "A" mem-get 2 list-get "a10" mem-set
  "A" mem-get 3 list-get "a11" mem-set
  "B" mem-get 0 list-get "b00" mem-set
  "B" mem-get 1 list-get "b01" mem-set
  "B" mem-get 2 list-get "b10" mem-set
  "B" mem-get 3 list-get "b11" mem-set
  
  # The 7 multiplications
  "a00" mem-get "a11" mem-get add   "b00" mem-get "b11" mem-get add   mul "M1" mem-set
  "a10" mem-get "a11" mem-get add   "b00" mem-get                     mul "M2" mem-set
  "a00" mem-get                     "b01" mem-get "b11" mem-get sub   mul "M3" mem-set
  "a11" mem-get                     "b10" mem-get "b00" mem-get sub   mul "M4" mem-set
  "a00" mem-get "a01" mem-get add   "b11" mem-get                     mul "M5" mem-set
  "a10" mem-get "a00" mem-get sub   "b00" mem-get "b01" mem-get add   mul "M6" mem-set
  "a01" mem-get "a11" mem-get sub   "b10" mem-get "b11" mem-get add   mul "M7" mem-set
  
  # Combine results
  "M1" mem-get "M4" mem-get add "M5" mem-get sub "M7" mem-get add  # C00
  "M3" mem-get "M5" mem-get add                                     # C01
  "M2" mem-get "M4" mem-get add                                     # C10
  "M1" mem-get "M2" mem-get sub "M3" mem-get add "M6" mem-get add  # C11
  
  4 list
] "mat2-mul-strassen" def

# ====================================================================
# VERIFICATION
# ====================================================================

[ # ( result expected name -- )
  "test-name" mem-set
  "expected" mem-set
  "result" mem-set
  
  # Compare lists element by element
  1 "match" mem-set
  4 [ 
    "i" mem-set
    "result" mem-get "i" mem-get list-get
    "expected" mem-get "i" mem-get list-get
    eq not [ 0 "match" mem-set ] [ ] if
  ] times
  
  "match" mem-get [
    "  ✓ " print "test-name" mem-get println
  ] [
    "  ✗ " print "test-name" mem-get print
    " got " print "result" mem-get quote-to-text println
  ] if
] "verify-matrix" def

"═══════════════════════════════════════════════════════════════════" println
"VERIFICATION: Standard vs Strassen produce same results" println
"═══════════════════════════════════════════════════════════════════" println
"" println

# Test case 1: Simple
1 2 3 4 4 list "A1" mem-set
5 6 7 8 4 list "B1" mem-set
# Expected: [1*5+2*7, 1*6+2*8, 3*5+4*7, 3*6+4*8] = [19, 22, 43, 50]
19 22 43 50 4 list "expected1" mem-set

"A1" mem-get "B1" mem-get mat2-mul-standard "expected1" mem-get "standard [[1,2],[3,4]] × [[5,6],[7,8]]" verify-matrix
"A1" mem-get "B1" mem-get mat2-mul-strassen "expected1" mem-get "strassen [[1,2],[3,4]] × [[5,6],[7,8]]" verify-matrix

# Test case 2: Identity
1 0 0 1 4 list "I" mem-set
"A1" mem-get "I" mem-get mat2-mul-standard "A1" mem-get "standard A × I = A" verify-matrix
"A1" mem-get "I" mem-get mat2-mul-strassen "A1" mem-get "strassen A × I = A" verify-matrix

# Test case 3: Negative numbers
-1 2 3 -4 4 list "A2" mem-set
2 -3 -1 4 4 list "B2" mem-set
# Expected: [(-1)*2+2*(-1), (-1)*(-3)+2*4, 3*2+(-4)*(-1), 3*(-3)+(-4)*4] = [-4, 11, 10, -25]
-4 11 10 -25 4 list "expected2" mem-set

"A2" mem-get "B2" mem-get mat2-mul-standard "expected2" mem-get "standard with negatives" verify-matrix
"A2" mem-get "B2" mem-get mat2-mul-strassen "expected2" mem-get "strassen with negatives" verify-matrix

"" println

# ====================================================================
# THE SEARCH SPACE
# ====================================================================
# To discover Strassen, we need to search for:
# 1. How to combine input elements (additions/subtractions)
# 2. Which pairs to multiply (the M1-M7 terms)
# 3. How to combine products to get output (more add/sub)
#
# Search space size for k multiplications:
# - Each multiplication uses 2 linear combinations of 8 inputs
# - Each linear combination has 8 coefficients in {-1, 0, 1}
# - That's 3^8 ≈ 6,561 combinations per term
# - For k multiplications: (6561)^(2k) × combinations for output
#
# For k=7: approximately 10^30 candidates - too large for brute force!

"═══════════════════════════════════════════════════════════════════" println
"SEARCH SPACE ANALYSIS" println
"═══════════════════════════════════════════════════════════════════" println
"" println

"Standard algorithm: 8 multiplications" println
"Strassen algorithm: 7 multiplications" println
"" println
"Search space for 7-mul algorithm:" println
"  Each multiplication = (linear combo of 8 inputs) × (linear combo of 8 inputs)" println
"  Coefficients ∈ {-1, 0, 1} → 3^8 = 6,561 possible terms" println
"  7 multiplications: ~10^27 combinations (infeasible for brute force)" println
"" println
"This is why DeepMind used RL with thousands of TPU-hours!" println
"" println

