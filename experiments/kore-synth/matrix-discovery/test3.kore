# Test 3×3 manually
# System: 2x + y + z = 5, x + 3y + 2z = 11, x + y + 4z = 13
# Expected solution: x=1, y=2, z=3 (verify: 2+2+3=7≠5...)
# Let me recalculate: if x=1,y=2,z=2: 2(1)+1(2)+1(2)=6≠5
# If x=1, y=1, z=2: 2(1)+1(1)+1(2)=5 ✓, 1+3(1)+2(2)=8≠11

# Actually, let's solve it properly:
# Let's just test det-3x3 first

[ "m" mem-set
  "m" mem-get 0 list-get
  "m" mem-get 4 list-get "m" mem-get 8 list-get mul
  "m" mem-get 5 list-get "m" mem-get 7 list-get mul sub
  mul
  "m" mem-get 1 list-get
  "m" mem-get 3 list-get "m" mem-get 8 list-get mul
  "m" mem-get 5 list-get "m" mem-get 6 list-get mul sub
  mul
  sub
  "m" mem-get 2 list-get
  "m" mem-get 3 list-get "m" mem-get 7 list-get mul
  "m" mem-get 4 list-get "m" mem-get 6 list-get mul sub
  mul
  add
] "det-3x3" def

"Test identity matrix 3×3:" println
1 0 0  0 1 0  0 0 1  9 list det-3x3 to-text println
"Expected: 1" println
"" println

"Test A matrix:" println
2 1 1  1 3 2  1 1 4  9 list det-3x3 to-text println
"Expected: det = 2(3*4-2*1) - 1(1*4-2*1) + 1(1*1-3*1)" println
"         = 2(12-2) - 1(4-2) + 1(1-3)" println
"         = 2(10) - 1(2) + 1(-2)" println
"         = 20 - 2 - 2 = 16" println
