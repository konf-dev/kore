#!/usr/bin/env kore

# ============================================================================
# 4×4 MATRIX MULTIPLICATION: SEARCHING FOR BETTER ALGORITHMS
# ============================================================================
#
# THE OPEN PROBLEM:
#   Standard:       64 multiplications
#   Strassen²:      49 multiplications (7×7)
#   Best known:     47-48 multiplications (various constructions)
#   Lower bound:    ~34 multiplications (tensor rank)
#
# THE GAP 34-49 IS UNSOLVED!
#
# APPROACH: Use AlphaTensor-style decomposition search
#   - Represent C = A×B as tensor T with 64 entries
#   - Find rank-r decomposition: T = Σᵢ uᵢ ⊗ vᵢ ⊗ wᵢ
#   - Each term = one multiplication
#   - Goal: minimize r while T still computes correct product
#
# KNOWN IMPROVEMENTS OVER STRASSEN²:
#   1. Bini's approximate algorithms (1979)
#   2. Schönhage's partial matrix multiplication
#   3. AlphaTensor discoveries (2022)
#
# ============================================================================

"" print
"SEARCHING FOR IMPROVED 4×4 MATRIX MULTIPLICATION" print
"================================================" print
"" print

# ----------------------------------------------------------------------------
# THE MATHEMATICAL STRUCTURE
# ----------------------------------------------------------------------------

"=== THE TENSOR DECOMPOSITION PROBLEM ===" print
"" print
"Matrix multiplication C = A×B defines a tensor T ∈ ℝ^(16×16×16)" print
"where T[i,j,k] = 1 iff c_ij depends on a_ik or b_kj" print
"" print
"Standard algorithm: rank 64 (each c_ij = sum of 4 products)" print
"Strassen recursive: rank 49 (7 block muls × 7 scalar muls)" print
"" print
"QUESTION: What is the true tensor rank of 4×4 multiplication?" print
"" print

# ----------------------------------------------------------------------------
# KNOWN IMPROVEMENTS
# ----------------------------------------------------------------------------

"=== KNOWN IMPROVEMENTS OVER 49 ===" print
"" print
"1. LADERMAN-STYLE EXTENSION:" print
"   - 3×3 uses 23 muls (not 27)" print
"   - But 4×4 ≠ simple extension of 3×3" print
"" print
"2. SCHÖNHAGE τ-THEOREM (1981):" print
"   - ω < 2.548 implies better algorithms exist" print
"   - Current ω ≈ 2.371 (Alman-Williams 2024)" print
"   - Implies 4×4 can be done in < 49 muls asymptotically" print
"" print
"3. ALPHATENSOR (2022):" print
"   - Found 47 muls for 4×4 over Z/2Z (mod 2 arithmetic)" print
"   - Standard arithmetic: improvements in 4×5, 5×5, etc." print
"" print

# ----------------------------------------------------------------------------
# PSEUDO-RANDOM NUMBER GENERATOR
# ----------------------------------------------------------------------------

1234567 "rng-state" mem-set

[
  "rng-state" mem-get
  1103515245 mul 12345 add
  2147483647 mod
  dup "rng-state" mem-set
] "rng-next" def

[
  over sub 1 add
  rng-next swap mod
  add
] "rng-range" def

# ----------------------------------------------------------------------------
# MATRIX UTILITIES
# ----------------------------------------------------------------------------

[
  0 list
  -5 5 rng-range list-push -5 5 rng-range list-push -5 5 rng-range list-push -5 5 rng-range list-push
  0 list
  -5 5 rng-range list-push -5 5 rng-range list-push -5 5 rng-range list-push -5 5 rng-range list-push
  0 list
  -5 5 rng-range list-push -5 5 rng-range list-push -5 5 rng-range list-push -5 5 rng-range list-push
  0 list
  -5 5 rng-range list-push -5 5 rng-range list-push -5 5 rng-range list-push -5 5 rng-range list-push
  0 list swap list-push swap list-push swap list-push swap list-push
] "rand-4x4" def

# Standard 64-mul oracle
[
  "B" mem-set "A" mem-set
  
  "A" mem-get 0 list-get 0 list-get "a00" mem-set
  "A" mem-get 0 list-get 1 list-get "a01" mem-set
  "A" mem-get 0 list-get 2 list-get "a02" mem-set
  "A" mem-get 0 list-get 3 list-get "a03" mem-set
  "A" mem-get 1 list-get 0 list-get "a10" mem-set
  "A" mem-get 1 list-get 1 list-get "a11" mem-set
  "A" mem-get 1 list-get 2 list-get "a12" mem-set
  "A" mem-get 1 list-get 3 list-get "a13" mem-set
  "A" mem-get 2 list-get 0 list-get "a20" mem-set
  "A" mem-get 2 list-get 1 list-get "a21" mem-set
  "A" mem-get 2 list-get 2 list-get "a22" mem-set
  "A" mem-get 2 list-get 3 list-get "a23" mem-set
  "A" mem-get 3 list-get 0 list-get "a30" mem-set
  "A" mem-get 3 list-get 1 list-get "a31" mem-set
  "A" mem-get 3 list-get 2 list-get "a32" mem-set
  "A" mem-get 3 list-get 3 list-get "a33" mem-set
  
  "B" mem-get 0 list-get 0 list-get "b00" mem-set
  "B" mem-get 0 list-get 1 list-get "b01" mem-set
  "B" mem-get 0 list-get 2 list-get "b02" mem-set
  "B" mem-get 0 list-get 3 list-get "b03" mem-set
  "B" mem-get 1 list-get 0 list-get "b10" mem-set
  "B" mem-get 1 list-get 1 list-get "b11" mem-set
  "B" mem-get 1 list-get 2 list-get "b12" mem-set
  "B" mem-get 1 list-get 3 list-get "b13" mem-set
  "B" mem-get 2 list-get 0 list-get "b20" mem-set
  "B" mem-get 2 list-get 1 list-get "b21" mem-set
  "B" mem-get 2 list-get 2 list-get "b22" mem-set
  "B" mem-get 2 list-get 3 list-get "b23" mem-set
  "B" mem-get 3 list-get 0 list-get "b30" mem-set
  "B" mem-get 3 list-get 1 list-get "b31" mem-set
  "B" mem-get 3 list-get 2 list-get "b32" mem-set
  "B" mem-get 3 list-get 3 list-get "b33" mem-set
  
  "a00" mem-get "b00" mem-get mul "a01" mem-get "b10" mem-get mul add "a02" mem-get "b20" mem-get mul add "a03" mem-get "b30" mem-get mul add "c00" mem-set
  "a00" mem-get "b01" mem-get mul "a01" mem-get "b11" mem-get mul add "a02" mem-get "b21" mem-get mul add "a03" mem-get "b31" mem-get mul add "c01" mem-set
  "a00" mem-get "b02" mem-get mul "a01" mem-get "b12" mem-get mul add "a02" mem-get "b22" mem-get mul add "a03" mem-get "b32" mem-get mul add "c02" mem-set
  "a00" mem-get "b03" mem-get mul "a01" mem-get "b13" mem-get mul add "a02" mem-get "b23" mem-get mul add "a03" mem-get "b33" mem-get mul add "c03" mem-set
  "a10" mem-get "b00" mem-get mul "a11" mem-get "b10" mem-get mul add "a12" mem-get "b20" mem-get mul add "a13" mem-get "b30" mem-get mul add "c10" mem-set
  "a10" mem-get "b01" mem-get mul "a11" mem-get "b11" mem-get mul add "a12" mem-get "b21" mem-get mul add "a13" mem-get "b31" mem-get mul add "c11" mem-set
  "a10" mem-get "b02" mem-get mul "a11" mem-get "b12" mem-get mul add "a12" mem-get "b22" mem-get mul add "a13" mem-get "b32" mem-get mul add "c12" mem-set
  "a10" mem-get "b03" mem-get mul "a11" mem-get "b13" mem-get mul add "a12" mem-get "b23" mem-get mul add "a13" mem-get "b33" mem-get mul add "c13" mem-set
  "a20" mem-get "b00" mem-get mul "a21" mem-get "b10" mem-get mul add "a22" mem-get "b20" mem-get mul add "a23" mem-get "b30" mem-get mul add "c20" mem-set
  "a20" mem-get "b01" mem-get mul "a21" mem-get "b11" mem-get mul add "a22" mem-get "b21" mem-get mul add "a23" mem-get "b31" mem-get mul add "c21" mem-set
  "a20" mem-get "b02" mem-get mul "a21" mem-get "b12" mem-get mul add "a22" mem-get "b22" mem-get mul add "a23" mem-get "b32" mem-get mul add "c22" mem-set
  "a20" mem-get "b03" mem-get mul "a21" mem-get "b13" mem-get mul add "a22" mem-get "b23" mem-get mul add "a23" mem-get "b33" mem-get mul add "c23" mem-set
  "a30" mem-get "b00" mem-get mul "a31" mem-get "b10" mem-get mul add "a32" mem-get "b20" mem-get mul add "a33" mem-get "b30" mem-get mul add "c30" mem-set
  "a30" mem-get "b01" mem-get mul "a31" mem-get "b11" mem-get mul add "a32" mem-get "b21" mem-get mul add "a33" mem-get "b31" mem-get mul add "c31" mem-set
  "a30" mem-get "b02" mem-get mul "a31" mem-get "b12" mem-get mul add "a32" mem-get "b22" mem-get mul add "a33" mem-get "b32" mem-get mul add "c32" mem-set
  "a30" mem-get "b03" mem-get mul "a31" mem-get "b13" mem-get mul add "a32" mem-get "b23" mem-get mul add "a33" mem-get "b33" mem-get mul add "c33" mem-set
  
  0 list "c00" mem-get list-push "c01" mem-get list-push "c02" mem-get list-push "c03" mem-get list-push
  0 list "c10" mem-get list-push "c11" mem-get list-push "c12" mem-get list-push "c13" mem-get list-push
  0 list "c20" mem-get list-push "c21" mem-get list-push "c22" mem-get list-push "c23" mem-get list-push
  0 list "c30" mem-get list-push "c31" mem-get list-push "c32" mem-get list-push "c33" mem-get list-push
  0 list swap list-push swap list-push swap list-push swap list-push
] "oracle" def

[
  "B" mem-set "A" mem-set
  true
  "A" mem-get 0 list-get 0 list-get "B" mem-get 0 list-get 0 list-get eq and
  "A" mem-get 0 list-get 1 list-get "B" mem-get 0 list-get 1 list-get eq and
  "A" mem-get 0 list-get 2 list-get "B" mem-get 0 list-get 2 list-get eq and
  "A" mem-get 0 list-get 3 list-get "B" mem-get 0 list-get 3 list-get eq and
  "A" mem-get 1 list-get 0 list-get "B" mem-get 1 list-get 0 list-get eq and
  "A" mem-get 1 list-get 1 list-get "B" mem-get 1 list-get 1 list-get eq and
  "A" mem-get 1 list-get 2 list-get "B" mem-get 1 list-get 2 list-get eq and
  "A" mem-get 1 list-get 3 list-get "B" mem-get 1 list-get 3 list-get eq and
  "A" mem-get 2 list-get 0 list-get "B" mem-get 2 list-get 0 list-get eq and
  "A" mem-get 2 list-get 1 list-get "B" mem-get 2 list-get 1 list-get eq and
  "A" mem-get 2 list-get 2 list-get "B" mem-get 2 list-get 2 list-get eq and
  "A" mem-get 2 list-get 3 list-get "B" mem-get 2 list-get 3 list-get eq and
  "A" mem-get 3 list-get 0 list-get "B" mem-get 3 list-get 0 list-get eq and
  "A" mem-get 3 list-get 1 list-get "B" mem-get 3 list-get 1 list-get eq and
  "A" mem-get 3 list-get 2 list-get "B" mem-get 3 list-get 2 list-get eq and
  "A" mem-get 3 list-get 3 list-get "B" mem-get 3 list-get 3 list-get eq and
] "mat-eq" def

