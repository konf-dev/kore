# Debug Test 3
[ "m" mem-set
  "m" mem-get 0 list-get "m" mem-get 3 list-get mul
  "m" mem-get 1 list-get "m" mem-get 2 list-get mul sub
] "det-2x2" def

"Test 3 debug:" println
3 -2 -1 4 4 list "A" mem-set
"det(A) = " print "A" mem-get det-2x2 to-text println
