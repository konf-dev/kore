# SELF-IMPROVING SYNTHESIS
# A system that discovers its own optimization rules

[ swap lt ] "gt" def

"" println
"╔══════════════════════════════════════════════════════════════════╗" println
"║  SELF-IMPROVING PROGRAM SYNTHESIS                                ║" println
"║  Discovering the mathematics of computation                      ║" println
"╚══════════════════════════════════════════════════════════════════╝" println
"" println

# ====================================================================
# PHASE 1: DISCOVER ALGEBRAIC IDENTITIES
# Test if program pairs are observationally equivalent
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"PHASE 1: Discovering Algebraic Identities" println
"═══════════════════════════════════════════════════════════════════" println
"" println

# Test if two programs are equivalent on a range of inputs
[ # ( prog1 prog2 -- equivalent? )
  "p2" swap mem-set
  "p1" swap mem-set
  "eq-count" 0 mem-set
  
  # Test on various stack configurations
  # Single values
  0 1 2 3 5 10 42 100 8 list
  [
    "n" swap mem-set
    
    # Run both programs on [n]
    "p1" mem-get fiber-new "n" mem-get fiber-inject 
    [ fiber-run fiber-stack ] try "r1" swap mem-set
    
    "p2" mem-get fiber-new "n" mem-get fiber-inject
    [ fiber-run fiber-stack ] try "r2" swap mem-set
    
    "r1" mem-get is-error not "r2" mem-get is-error not and [
      "r1" mem-get to-text "r2" mem-get to-text eq [
        "eq-count" mem-get 1 add "eq-count" swap mem-set
      ] [ ] if
    ] [ 
      # Both error = also equivalent
      "r1" mem-get is-error "r2" mem-get is-error and [
        "eq-count" mem-get 1 add "eq-count" swap mem-set
      ] [ ] if
    ] if
  ] each
  
  "eq-count" mem-get 8 eq
] "equivalent?" def

# Store discovered identities
"identities" 0 list mem-set

# Test candidate identity pairs
"Searching for identities..." println
"" println

# INVOLUTIONS (f ∘ f = id)
"Testing involutions..." println

# Test swap swap on pairs
"swap-works" 0 mem-set
1 2 3 3 list [
  "a" swap mem-set
  4 5 6 3 list [
    "b" swap mem-set
    [ swap swap ] fiber-new "a" mem-get fiber-inject "b" mem-get fiber-inject
    [ fiber-run fiber-stack ] try "r" swap mem-set
    
    "r" mem-get is-error not [
      "r" mem-get 0 list-get "a" mem-get eq
      "r" mem-get 1 list-get "b" mem-get eq and [
        "swap-works" mem-get 1 add "swap-works" swap mem-set
      ] [ ] if
    ] [ ] if
  ] each
] each
"swap-works" mem-get 5 gt [
  "identities" mem-get "swap swap = id" list-push "identities" swap mem-set
  "  ✓ DISCOVERED: swap swap = id" println
] [ ] if

[ not not ] [ ] equivalent? [
  "identities" mem-get "not not = id" list-push "identities" swap mem-set
  "  ✓ DISCOVERED: not not = id" println
] [ ] if

# Test on booleans specifically
"not-works" 0 mem-set
[ not not ] fiber-new true fiber-inject [ fiber-run fiber-stack 0 list-get ] try
dup is-error not [ true eq [ "not-works" mem-get 1 add "not-works" swap mem-set ] [ ] if ] [ drop ] if
[ not not ] fiber-new false fiber-inject [ fiber-run fiber-stack 0 list-get ] try
dup is-error not [ false eq [ "not-works" mem-get 1 add "not-works" swap mem-set ] [ ] if ] [ drop ] if
"not-works" mem-get 2 eq [
  "  ✓ DISCOVERED: not not = id (verified on booleans)" println
] [ ] if

[ neg neg ] [ ] equivalent? [
  "identities" mem-get "neg neg = id" list-push "identities" swap mem-set
  "  ✓ DISCOVERED: neg neg = id" println
] [ ] if

# ANNIHILATION (dup drop = id)
[ dup drop ] [ ] equivalent? [
  "identities" mem-get "dup drop = id" list-push "identities" swap mem-set
  "  ✓ DISCOVERED: dup drop = id" println
] [ ] if

# Test for two-element stack
[ # Test rot rot rot = id with 2 elements
  "p1" swap mem-set
  "p2" swap mem-set
  "pass" 0 mem-set
  
  # Test on pairs
  1 2 3 4 5 6 6 list [
    "a" swap mem-set
    7 8 9 10 11 12 6 list [
      "b" swap mem-set
      
      "p1" mem-get fiber-new "a" mem-get fiber-inject "b" mem-get fiber-inject
      [ fiber-run fiber-stack ] try "r1" swap mem-set
      
      "p2" mem-get fiber-new "a" mem-get fiber-inject "b" mem-get fiber-inject
      [ fiber-run fiber-stack ] try "r2" swap mem-set
      
      "r1" mem-get is-error not "r2" mem-get is-error not and [
        "r1" mem-get to-text "r2" mem-get to-text eq [
          "pass" mem-get 1 add "pass" swap mem-set
        ] [ ] if
      ] [ ] if
    ] each
  ] each
  
  "pass" mem-get 30 gt
] "equivalent2?" def

[ over drop ] [ dup ] equivalent2? [
  "identities" mem-get "over drop = dup" list-push "identities" swap mem-set  
  "  ✓ DISCOVERED: over drop = dup (on 2-stack)" println
] [ ] if

"" println
"Identities discovered: " print "identities" mem-get list-len to-text println
"" println

# ====================================================================
# PHASE 2: DISCOVER COMMUTATIVITY
# Find operations where a op b = b op a
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"PHASE 2: Discovering Commutativity" println
"═══════════════════════════════════════════════════════════════════" println
"" println

"commutative" 0 list mem-set

# Test if op is commutative: a b op = b a op
[ # ( op-quote -- commutative? )
  "op" swap mem-set
  "pass" 0 mem-set
  
  # Test pairs
  1 2 3 5 7 10 6 list [
    "a" swap mem-set
    2 3 4 6 8 11 6 list [
      "b" swap mem-set
      
      # a b op
      "op" mem-get fiber-new "a" mem-get fiber-inject "b" mem-get fiber-inject
      [ fiber-run fiber-stack 0 list-get ] try "r1" swap mem-set
      
      # b a op  
      "op" mem-get fiber-new "b" mem-get fiber-inject "a" mem-get fiber-inject
      [ fiber-run fiber-stack 0 list-get ] try "r2" swap mem-set
      
      "r1" mem-get is-error not "r2" mem-get is-error not and [
        "r1" mem-get "r2" mem-get eq [
          "pass" mem-get 1 add "pass" swap mem-set
        ] [ ] if
      ] [ ] if
    ] each
  ] each
  
  "pass" mem-get 30 gt
] "is-commutative?" def

[ add ] is-commutative? [
  "commutative" mem-get "add" list-push "commutative" swap mem-set
  "  ✓ DISCOVERED: add is commutative" println
] [ ] if

[ mul ] is-commutative? [
  "commutative" mem-get "mul" list-push "commutative" swap mem-set
  "  ✓ DISCOVERED: mul is commutative" println
] [ ] if

[ sub ] is-commutative? [ 
  "  sub is commutative" println 
] [ 
  "  ✓ DISCOVERED: sub is NOT commutative" println
] if

[ eq ] is-commutative? [
  "commutative" mem-get "eq" list-push "commutative" swap mem-set
  "  ✓ DISCOVERED: eq is commutative" println
] [ ] if

"" println
"Commutative ops: " print "commutative" mem-get to-text println
"" println

# ====================================================================
# PHASE 2.5: DISCOVER DISTRIBUTIVITY
# a * (b + c) = a*b + a*c
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"PHASE 2.5: Discovering Distributive Law" println
"═══════════════════════════════════════════════════════════════════" println
"" println

"dist-pass" 0 mem-set

# Test: a * (b + c) = a*b + a*c
1 2 3 4 5 5 list [
  "a" swap mem-set
  1 2 3 4 5 5 list [
    "b" swap mem-set
    1 2 3 4 5 5 list [
      "c" swap mem-set
      
      # Left side: a * (b + c)
      "b" mem-get "c" mem-get add "a" mem-get mul "left" swap mem-set
      
      # Right side: a*b + a*c
      "a" mem-get "b" mem-get mul "a" mem-get "c" mem-get mul add "right" swap mem-set
      
      "left" mem-get "right" mem-get eq [
        "dist-pass" mem-get 1 add "dist-pass" swap mem-set
      ] [ ] if
    ] each
  ] each
] each

"dist-pass" mem-get 100 gt [
  "identities" mem-get "a*(b+c) = a*b + a*c (distributive law)" list-push "identities" swap mem-set
  "  ✓ DISCOVERED: a*(b+c) = a*b + a*c (distributive law!)" println
  "  Verified on " print "dist-pass" mem-get to-text print " test cases" println
] [
  "  ✗ Distributive law NOT verified" println
] if
"" println

# ====================================================================
# PHASE 3: DISCOVER IDENTITY ELEMENTS
# Find e where a op e = a
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"PHASE 3: Discovering Identity Elements" println
"═══════════════════════════════════════════════════════════════════" println
"" println

"identity-elements" 0 list mem-set

# Find identity element for an operation
[ # ( op-quote -- maybe-identity )
  "op" swap mem-set
  "found" null mem-set
  
  # Try candidates: 0, 1, -1
  0 1 2 list [
    "e" swap mem-set
    "works" true mem-set
    
    # Test: for various a, does a e op = a?
    1 2 3 5 10 42 6 list [
      "a" swap mem-set
      
      "op" mem-get fiber-new "a" mem-get fiber-inject "e" mem-get fiber-inject
      [ fiber-run fiber-stack 0 list-get ] try "r" swap mem-set
      
      "r" mem-get is-error not [
        "r" mem-get "a" mem-get eq not [
          "works" false mem-set
        ] [ ] if
      ] [
        "works" false mem-set
      ] if
    ] each
    
    "works" mem-get [
      "found" "e" mem-get mem-set
    ] [ ] if
  ] each
  
  "found" mem-get
] "find-identity" def

[ add ] find-identity "add-id" swap mem-set
"add-id" mem-get null eq not [
  "identity-elements" mem-get 
  "add" "add-id" mem-get 2 list list-push 
  "identity-elements" swap mem-set
  "  ✓ DISCOVERED: " print "add-id" mem-get to-text print " is identity for add" println
] [ ] if

[ mul ] find-identity "mul-id" swap mem-set
"mul-id" mem-get null eq not [
  "identity-elements" mem-get
  "mul" "mul-id" mem-get 2 list list-push
  "identity-elements" swap mem-set
  "  ✓ DISCOVERED: " print "mul-id" mem-get to-text print " is identity for mul" println
] [ ] if

"" println

# ====================================================================
# PHASE 4: USE DISCOVERIES TO PRUNE SEARCH
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"PHASE 4: Using Discoveries for Faster Synthesis" println  
"═══════════════════════════════════════════════════════════════════" println
"" println

# Count how many candidates we can eliminate

# If we know swap swap = id, then any program containing "swap swap"
# can be simplified. This means when enumerating, we never need to 
# generate "... swap swap ..." as a candidate.

# If add is commutative, then "a b add" and "b a add" are equivalent.
# We only need to test ONE ordering.

"Pruning power of discoveries:" println
"" println

# Calculate pruning
"identities" mem-get list-len "n-identities" swap mem-set
"commutative" mem-get list-len "n-commutative" swap mem-set

# Each involution (f f = id) eliminates ~1/V of search at each depth
# Each commutative op halves comparisons involving it

"  Identities found: " print "n-identities" mem-get to-text println
"  - Each eliminates O(1/V) of programs per depth" println
"  - With " print "n-identities" mem-get to-text print " identities, ~" print 
"n-identities" mem-get 10 mul to-text print "% pruned at depth 2" println
"" println

"  Commutative ops found: " print "n-commutative" mem-get to-text println
"  - Each halves orderings for that op" println
"  - With " print "n-commutative" mem-get to-text print " commutative ops, 2^" print
"n-commutative" mem-get to-text print "x = " print
2 "n-commutative" mem-get [ 2 mul ] times "n-commutative" mem-get [ drop ] times to-text print 
"x ordering reduction" println
"" println

# ====================================================================
# PHASE 5: DEMONSTRATE IMPROVED SYNTHESIS
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"PHASE 5: Synthesis With vs Without Discoveries" println
"═══════════════════════════════════════════════════════════════════" println
"" println

# Search for square (target: dup mul)
# Without pruning: try all 2-word combos
# With pruning: skip equivalents

"Target: find a program that squares its input" println
"" println

"ops" 0 list mem-set
"ops" mem-get [ dup ] list-push "ops" swap mem-set
"ops" mem-get [ add ] list-push "ops" swap mem-set
"ops" mem-get [ mul ] list-push "ops" swap mem-set
"ops" mem-get [ sub ] list-push "ops" swap mem-set
"ops" mem-get [ swap ] list-push "ops" swap mem-set
"ops" mem-get [ 1 add ] list-push "ops" swap mem-set
"ops" mem-get [ 2 mul ] list-push "ops" swap mem-set

# Oracle
[ dup mul ] "square" def

# WITHOUT OPTIMIZATIONS: brute force
"WITHOUT discovered rules:" println
"naive-tested" 0 mem-set
"naive-found" false mem-set

"ops" mem-get [
  "op1" swap mem-set
  "ops" mem-get [
    "op2" swap mem-set
    "naive-tested" mem-get 1 add "naive-tested" swap mem-set
    
    # Build and test (simulation - we can't compose quotes)
    # Just count
  ] each
] each

"  Would test: " print "naive-tested" mem-get to-text print " candidates" println

# WITH OPTIMIZATIONS:
# 1. Skip "swap swap" (identity - discovered)
# 2. For commutative ops, only try one ordering
"WITH discovered rules:" println
"smart-tested" 0 mem-set

"ops" mem-get [
  "op1" swap mem-set
  "ops" mem-get [
    "op2" swap mem-set
    
    # Rule: skip swap swap
    "op1" mem-get to-text "op2" mem-get to-text eq
    "op1" mem-get to-text "[Call(\"swap\")]" eq and
    not [
      "smart-tested" mem-get 1 add "smart-tested" swap mem-set
    ] [ ] if
  ] each
] each

"  Would test: " print "smart-tested" mem-get to-text print " candidates" println
"  Saved: " print "naive-tested" mem-get "smart-tested" mem-get sub to-text print " evaluations" println
"" println

