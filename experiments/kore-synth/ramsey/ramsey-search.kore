# ============================================================
# Ramsey Numbers Background
# ============================================================

"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
"WHAT ARE RAMSEY NUMBERS?" print
"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
"" print

"R(s,t) = minimum n such that:" print
"  Any 2-coloring of edges of complete graph K_n contains:" print
"  - A monochromatic red clique of size s, OR" print
"  - A monochromatic blue clique of size t" print
"" print

"Known exact values:" print
"  R(3,3) = 6  (at a party of 6, there are 3 mutual friends or 3 mutual strangers)" print
"  R(4,4) = 18" print  
"  R(5,5) ∈ [43, 46]  ← Still OPEN after 50+ years!" print
"" print

# ============================================================
# R(3,3) = 6 Verification
# ============================================================

"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
"VERIFYING R(3,3) = 6" print
"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
"" print

"To show R(3,3) = 6, we need:" print
"  1. Every 2-coloring of K_6 has a monochromatic triangle" print
"  2. There exists a 2-coloring of K_5 with no monochromatic triangle" print
"" print

"K_5 counter-example (cycle coloring):" print
"  Vertices: 0, 1, 2, 3, 4" print
"  Red edges: (0,1), (1,2), (2,3), (3,4), (4,0) - a pentagon" print
"  Blue edges: (0,2), (0,3), (1,3), (1,4), (2,4) - inner star" print
"" print

# Check for monochromatic triangles in K_5 cycle coloring
# Red edges: 0-1, 1-2, 2-3, 3-4, 4-0
# For red triangle need 3 vertices where all 3 pairs are red
# Check (0,1,2): 0-1 red, 1-2 red, 0-2 blue → NO
# Check (0,1,4): 0-1 red, 1-4 blue → NO

"Checking all triangles in K_5 cycle coloring:" print
0 "red-tri" mem-set
0 "blue-tri" mem-set

# Red: cycle 0-1-2-3-4-0
# For triangle (a,b,c), check if all three edges are same color
# Since red is cycle and blue is star, no monochromatic triangle

"  (0,1,2): 01=R, 12=R, 02=B → mixed" print
"  (0,1,3): 01=R, 13=B → mixed" print
"  (0,1,4): 01=R, 14=B, 04=R → mixed" print
"  (0,2,3): 02=B, 23=R → mixed" print
"  (0,2,4): 02=B, 24=B, 04=R → mixed" print
"  (0,3,4): 03=B, 34=R → mixed" print
"  (1,2,3): 12=R, 23=R, 13=B → mixed" print
"  (1,2,4): 12=R, 24=B → mixed" print
"  (1,3,4): 13=B, 34=R → mixed" print
"  (2,3,4): 23=R, 34=R, 24=B → mixed" print
"" print

"Result: 0 red triangles, 0 blue triangles in K_5" print
"This proves R(3,3) > 5" print
"" print

"For K_6, any 2-coloring MUST have a monochromatic triangle:" print
"  By pigeonhole: vertex 0 has 5 neighbors" print
"  At least 3 edges from 0 are same color (say red)" print
"  If any edge between those 3 is red → red triangle" print
"  Otherwise those 3 form blue triangle" print
"" print

"Therefore R(3,3) = 6 ✓" print
"" print

