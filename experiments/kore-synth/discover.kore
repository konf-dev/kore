"" println
"=== PATTERN EMERGENCE ===" println
"Analyzing which programs produce perfect squares..." println
"" println

4 9 16 25 36 49 64 81 100 121 144 169 196 13 list
[
  "target" swap mem-set
  "target" mem-get 1 list search
  "lv" swap mem-set
  "sol" swap mem-set
  "ok" swap mem-set
  
  "ok" mem-get [
    "target" mem-get to-text " = " str-concat
    "sol" mem-get str-concat println
  ] [ ] if
] each

