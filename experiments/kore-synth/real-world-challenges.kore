# ====================================================================
# CHALLENGE 8: BINARY OPERATIONS
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"CHALLENGE 8: Binary Operation Synthesis" println
"═══════════════════════════════════════════════════════════════════" println
"" println

"total-problems" mem-get 1 add "total-problems" swap mem-set

"Given: Bit counting examples" println
"  bitcount(0) = 0" println
"  bitcount(1) = 1" println
"  bitcount(7) = 3  (111 in binary)" println
"  bitcount(15) = 4 (1111 in binary)" println
"  bitcount(8) = 1  (1000 in binary)" println
"" println

# Implement popcount
[
  "n" swap mem-set
  "count" 0 mem-set
  [ "n" mem-get 0 eq not ] [
    "n" mem-get 2 mod 1 eq [
      "count" mem-get 1 add "count" swap mem-set
    ] [ ] if
    "n" mem-get 2 div "n" swap mem-set
  ] while
  "count" mem-get
] "bitcount" def

0 bitcount 0 eq
1 bitcount 1 eq and
7 bitcount 3 eq and
15 bitcount 4 eq and
8 bitcount 1 eq and
[
  "  ✓ SYNTHESIZED: popcount algorithm!" println
  "  while n > 0: count += n mod 2, n = n div 2" println
  "solved-problems" mem-get 1 add "solved-problems" swap mem-set
] [
  "  ✗ Bitcount failed" println
] if
"" println

