  "c" mem-get fiber-new 10 15 2 list fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 5 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  "c" mem-get fiber-new 3 20 2 list fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 17 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  "pass" mem-get 3 eq "solved" mem-get not and [
