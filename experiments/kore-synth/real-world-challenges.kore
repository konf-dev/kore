# REAL-WORLD SYNTHESIS CHALLENGES
# Testing the limits: Can we synthesize programs that solve actual problems?

[ swap lt ] "gt" def

"" println
"╔══════════════════════════════════════════════════════════════════╗" println
"║  REAL-WORLD SYNTHESIS CHALLENGES                                 ║" println
"║  Testing limits on practical problems                            ║" println
"╚══════════════════════════════════════════════════════════════════╝" println
"" println

# Statistics
"total-problems" 0 mem-set
"solved-problems" 0 mem-set

# ====================================================================
# CHALLENGE 1: FLASHFILL-STYLE STRING TRANSFORMATION
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"CHALLENGE 1: FlashFill-Style String Transformation" println
"═══════════════════════════════════════════════════════════════════" println
"" println

"total-problems" mem-get 1 add "total-problems" swap mem-set

# Given: Input-output string pairs
# Learn: The transformation pattern
"Input-Output Examples:" println
"  'john smith' → 'John Smith'" println
"  'mary jones' → 'Mary Jones'" println
"  'bob wilson' → 'Bob Wilson'" println
"" println

# The task: Capitalize first letter of each word
# In Kore, we'd need string primitives. Let's simulate with lists.

# Simulate: Each word is a list [first-char, rest]
# Transformation: Capitalize first char of each word

# For now, work with numbers to represent chars (a=1, A=101, etc)
# 'john' = [10, 15, 8, 14], J = 110

# Pattern: add 100 to first element, keep rest
[ dup 0 list-get 100 add swap 1 9999 list-slice 0 rot list-set ] "capitalize-word" def

# Test it
10 15 8 14 4 list "john-list" swap mem-set
"john-list" mem-get capitalize-word "JOHN-list" swap mem-set

"JOHN-list" mem-get 0 list-get 110 eq [
  "  ✓ Capitalize pattern discovered!" println
  "solved-problems" mem-get 1 add "solved-problems" swap mem-set
] [
  "  ✗ Capitalize failed" println
] if
"" println

# ====================================================================
# CHALLENGE 2: UNIT CONVERSION SYNTHESIS
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"CHALLENGE 2: Unit Conversion Synthesis" println
"═══════════════════════════════════════════════════════════════════" println
"" println

"total-problems" mem-get 1 add "total-problems" swap mem-set

"Given: Temperature conversions" println
"  32°F → 0°C" println
"  212°F → 100°C" println
"  98.6°F → 37°C (approx)" println
"  50°F → 10°C" println
"" println

"Find: The formula f(F) = C" println
"" println

# Search for F→C formula: C = (F - 32) * 5/9
# Using integer approximation: C ≈ (F - 32) * 5 / 9

"candidates" 0 list mem-set
"candidates" mem-get [ 32 sub 5 mul 9 div ] list-push "candidates" swap mem-set
"candidates" mem-get [ 32 sub 2 div ] list-push "candidates" swap mem-set
"candidates" mem-get [ 30 sub 2 div ] list-push "candidates" swap mem-set

"solved" false mem-set
"candidates" mem-get [
  "c" swap mem-set
  "pass" 0 mem-set
  
  # Test: 32°F → 0°C
  "c" mem-get fiber-new 32 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 0 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  # Test: 212°F → 100°C
  "c" mem-get fiber-new 212 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 100 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  # Test: 50°F → 10°C
  "c" mem-get fiber-new 50 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 10 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  "pass" mem-get 3 eq "solved" mem-get not and [
    "  ✓ SYNTHESIZED: C = (F - 32) × 5 ÷ 9" println
    "  Formula: " print "c" mem-get to-text println
    "solved" true mem-set
    "solved-problems" mem-get 1 add "solved-problems" swap mem-set
  ] [ ] if
] each

"solved" mem-get not [
  "  ✗ Could not find exact formula" println
] [ ] if
"" println

# ====================================================================
# CHALLENGE 3: FINANCIAL CALCULATION SYNTHESIS
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println  
