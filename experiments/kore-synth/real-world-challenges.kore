"═══════════════════════════════════════════════════════════════════" println
"" println

"total-problems" mem-get 1 add "total-problems" swap mem-set

"Given: Caesar cipher examples (shift=3)" println
"  encode(1) = 4    (a→d)" println
"  encode(2) = 5    (b→e)" println  
"  encode(26) = 3   (z→c, wraps around)" println
"  decode(4) = 1    (d→a)" println
"" println

"Find: encode = (x + 2) mod 26 + 1, decode = (x + 22) mod 26 + 1" println
"" println

# Encode: (x + 3 - 1) mod 26 + 1 = (x + 2) mod 26 + 1
"candidates" 0 list mem-set
"candidates" mem-get [ 2 add 26 mod 1 add ] list-push "candidates" swap mem-set
"candidates" mem-get [ 3 add ] list-push "candidates" swap mem-set
"candidates" mem-get [ 3 add 26 mod ] list-push "candidates" swap mem-set

"solved" false mem-set
"candidates" mem-get [
  "c" swap mem-set
  "pass" 0 mem-set
  
  "c" mem-get fiber-new 1 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 4 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  "c" mem-get fiber-new 2 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 5 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  "c" mem-get fiber-new 26 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 3 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  "pass" mem-get 3 eq "solved" mem-get not and [
    "  ✓ SYNTHESIZED: encode(x) = (x + 2) mod 26 + 1" println
    "solved" true mem-set
    "solved-problems" mem-get 1 add "solved-problems" swap mem-set
  ] [ ] if
] each
"" println

