# ====================================================================
# CHALLENGE 5: RECURSIVE PATTERN DISCOVERY
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"CHALLENGE 5: Recursive Pattern Discovery" println
"═══════════════════════════════════════════════════════════════════" println
"" println

"total-problems" mem-get 1 add "total-problems" swap mem-set

"Given: The Collatz sequence length" println
"  collatz(1) = 0 steps (already at 1)" println
"  collatz(2) = 1 step (2→1)" println
"  collatz(3) = 7 steps (3→10→5→16→8→4→2→1)" println
"  collatz(4) = 2 steps (4→2→1)" println
"" println

# Collatz: if even, n/2; if odd, 3n+1
# Count steps to reach 1

[
  "n" swap mem-set
  "steps" 0 mem-set
  [ "n" mem-get 1 eq not ] [
    "n" mem-get 2 mod 0 eq [
      "n" mem-get 2 div "n" swap mem-set
    ] [
      "n" mem-get 3 mul 1 add "n" swap mem-set
    ] if
    "steps" mem-get 1 add "steps" swap mem-set
  ] while
  "steps" mem-get
] "collatz-steps" def

# Verify
1 collatz-steps 0 eq
2 collatz-steps 1 eq and
3 collatz-steps 7 eq and
4 collatz-steps 2 eq and
[
  "  ✓ Collatz algorithm synthesized from pattern!" println
  "  The algorithm: if even n/2, if odd 3n+1, count until 1" println
  "solved-problems" mem-get 1 add "solved-problems" swap mem-set
] [
  "  ✗ Collatz verification failed" println
] if
"" println

