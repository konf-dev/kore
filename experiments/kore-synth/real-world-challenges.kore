"total-problems" mem-get 1 add "total-problems" swap mem-set

"Given: Simple interest calculations" println
"  Principal $1000, Rate 5%, Time 2yr → Interest $100" println
"  Principal $500, Rate 10%, Time 1yr → Interest $50" println
"  Principal $2000, Rate 5%, Time 3yr → Interest $300" println
"" println

"Find: Interest = P × R × T / 100" println
"" println

# The formula: I = P * R * T / 100
# Input is (P, R, T) as list

"candidates" 0 list mem-set
"candidates" mem-get [ dup 0 list-get swap dup 1 list-get swap 2 list-get mul mul 100 div ] list-push "candidates" swap mem-set
"candidates" mem-get [ dup 0 list-get swap 1 list-get mul ] list-push "candidates" swap mem-set

"solved" false mem-set
"candidates" mem-get [
  "c" swap mem-set
  "pass" 0 mem-set
  
  # Test 1: (1000, 5, 2) → 100
  "c" mem-get fiber-new 1000 5 2 3 list fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 100 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  # Test 2: (500, 10, 1) → 50
  "c" mem-get fiber-new 500 10 1 3 list fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 50 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  # Test 3: (2000, 5, 3) → 300
  "c" mem-get fiber-new 2000 5 3 3 list fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 300 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  "pass" mem-get 3 eq "solved" mem-get not and [
    "  ✓ SYNTHESIZED: Interest = Principal × Rate × Time ÷ 100" println
    "solved" true mem-set
    "solved-problems" mem-get 1 add "solved-problems" swap mem-set
  ] [ ] if
] each
"" println

