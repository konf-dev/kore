"EFFECT ALGEBRA FOR SORTING NETWORKS" print
"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
"" print

"Each compare-and-swap is an EFFECT that:" print
"  1. Reads two wires" print
"  2. Potentially swaps their values" print
"  3. Writes back to two wires" print
"" print

"Effect composition rules:" print
"  - CAS(i,j) . CAS(i,j) = CAS(i,j)  [idempotent]" print
"  - CAS(i,j) . CAS(k,l) = CAS(k,l) . CAS(i,j)  when disjoint" print
"  - Non-trivial: CAS(0,1) . CAS(1,2) != CAS(1,2) . CAS(0,1)" print
"" print

"Effect pruning strategies:" print
"  1. REDUNDANCY: Never repeat same CAS consecutively" print
"  2. SUBSUMPTION: CAS(i,k) after sorted(i,j,k) is wasted" print
"  3. COVERAGE: Each wire must appear in enough CAS ops" print
"" print

"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
