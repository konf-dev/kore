# ╔══════════════════════════════════════════════════════════════════╗
# ║  SORTING NETWORK VERIFICATION                                    ║
# ║  Benchmark: n=4→5 comparators (optimal, proven by Floyd 1964)   ║
# ╚══════════════════════════════════════════════════════════════════╝

"╔══════════════════════════════════════════════════════════════════╗" print
"║  SORTING NETWORK VERIFICATION - Effect Algebra                   ║" print
"╚══════════════════════════════════════════════════════════════════╝" print
"" print

0 "comparators" mem-set

"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
"PART 1: Sort-4 Network (5 comparators)" print
"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
"" print

# CAS macros using swap lt for a0 > a1
[
  "a0" mem-get "a1" mem-get swap lt
  [ "a0" mem-get "t" mem-set "a1" mem-get "a0" mem-set "t" mem-get "a1" mem-set ] [ ] if
  "comparators" mem-get 1 add "comparators" mem-set
] "cas01" mem-set

[
  "a2" mem-get "a3" mem-get swap lt
  [ "a2" mem-get "t" mem-set "a3" mem-get "a2" mem-set "t" mem-get "a3" mem-set ] [ ] if
  "comparators" mem-get 1 add "comparators" mem-set
] "cas23" mem-set

[
  "a0" mem-get "a2" mem-get swap lt
  [ "a0" mem-get "t" mem-set "a2" mem-get "a0" mem-set "t" mem-get "a2" mem-set ] [ ] if
  "comparators" mem-get 1 add "comparators" mem-set
] "cas02" mem-set

[
  "a1" mem-get "a3" mem-get swap lt
  [ "a1" mem-get "t" mem-set "a3" mem-get "a1" mem-set "t" mem-get "a3" mem-set ] [ ] if
  "comparators" mem-get 1 add "comparators" mem-set
] "cas13" mem-set

[
  "a1" mem-get "a2" mem-get swap lt
  [ "a1" mem-get "t" mem-set "a2" mem-get "a1" mem-set "t" mem-get "a2" mem-set ] [ ] if
  "comparators" mem-get 1 add "comparators" mem-set
] "cas12" mem-set

# Sort-4: CAS(0,1), CAS(2,3), CAS(0,2), CAS(1,3), CAS(1,2)
[
  "in" mem-set
  "in" mem-get 0 list-get "a0" mem-set
  "in" mem-get 1 list-get "a1" mem-set
  "in" mem-get 2 list-get "a2" mem-set
  "in" mem-get 3 list-get "a3" mem-set
  0 "comparators" mem-set
  
  "cas01" mem-get call
  "cas23" mem-get call
  "cas02" mem-get call
  "cas13" mem-get call
  "cas12" mem-get call
  
  0 list "a0" mem-get list-push "a1" mem-get list-push "a2" mem-get list-push "a3" mem-get list-push
] "sort4" mem-set

# Check if sorted: v0 <= v1 <= v2 <= v3
[
  "lst" mem-set
  "lst" mem-get 0 list-get "v0" mem-set
  "lst" mem-get 1 list-get "v1" mem-set
  "lst" mem-get 2 list-get "v2" mem-set
  "lst" mem-get 3 list-get "v3" mem-set
  
  "v0" mem-get "v1" mem-get swap lt not
  "v1" mem-get "v2" mem-get swap lt not and
  "v2" mem-get "v3" mem-get swap lt not and
] "is-sorted" mem-set

# Test a few cases and count effects
"Testing Sort-4..." print

0 list 4 list-push 3 list-push 2 list-push 1 list-push "sort4" mem-get call 
"is-sorted" mem-get call "test1" mem-set
"  [4,3,2,1] sorted? " print "test1" mem-get to-text print
"  Effects: " print "comparators" mem-get to-text print

0 list 1 list-push 2 list-push 3 list-push 4 list-push "sort4" mem-get call
"is-sorted" mem-get call "test2" mem-set
"  [1,2,3,4] sorted? " print "test2" mem-get to-text print
"  Effects: " print "comparators" mem-get to-text print

0 list 3 list-push 1 list-push 4 list-push 2 list-push "sort4" mem-get call
"is-sorted" mem-get call "test3" mem-set
"  [3,1,4,2] sorted? " print "test3" mem-get to-text print
"  Effects: " print "comparators" mem-get to-text print

"" print

"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
"PART 2: Exhaustive Testing (all 24 permutations)" print
"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
"" print

0 "passed" mem-set
0 "failed" mem-set

# Helper: test and count
[
  "perm" mem-set
  "perm" mem-get "sort4" mem-get call "is-sorted" mem-get call
  [ "passed" mem-get 1 add "passed" mem-set ]
  [ "failed" mem-get 1 add "failed" mem-set ]
  if
] "test-perm" mem-set

# Inline all 24 permutations of {1,2,3,4}
0 list 1 list-push 2 list-push 3 list-push 4 list-push "test-perm" mem-get call
0 list 1 list-push 2 list-push 4 list-push 3 list-push "test-perm" mem-get call
0 list 1 list-push 3 list-push 2 list-push 4 list-push "test-perm" mem-get call
0 list 1 list-push 3 list-push 4 list-push 2 list-push "test-perm" mem-get call
0 list 1 list-push 4 list-push 2 list-push 3 list-push "test-perm" mem-get call
0 list 1 list-push 4 list-push 3 list-push 2 list-push "test-perm" mem-get call

0 list 2 list-push 1 list-push 3 list-push 4 list-push "test-perm" mem-get call
0 list 2 list-push 1 list-push 4 list-push 3 list-push "test-perm" mem-get call
0 list 2 list-push 3 list-push 1 list-push 4 list-push "test-perm" mem-get call
0 list 2 list-push 3 list-push 4 list-push 1 list-push "test-perm" mem-get call
0 list 2 list-push 4 list-push 1 list-push 3 list-push "test-perm" mem-get call
0 list 2 list-push 4 list-push 3 list-push 1 list-push "test-perm" mem-get call

0 list 3 list-push 1 list-push 2 list-push 4 list-push "test-perm" mem-get call
0 list 3 list-push 1 list-push 4 list-push 2 list-push "test-perm" mem-get call
0 list 3 list-push 2 list-push 1 list-push 4 list-push "test-perm" mem-get call
0 list 3 list-push 2 list-push 4 list-push 1 list-push "test-perm" mem-get call
0 list 3 list-push 4 list-push 1 list-push 2 list-push "test-perm" mem-get call
0 list 3 list-push 4 list-push 2 list-push 1 list-push "test-perm" mem-get call

0 list 4 list-push 1 list-push 2 list-push 3 list-push "test-perm" mem-get call
0 list 4 list-push 1 list-push 3 list-push 2 list-push "test-perm" mem-get call
0 list 4 list-push 2 list-push 1 list-push 3 list-push "test-perm" mem-get call
0 list 4 list-push 2 list-push 3 list-push 1 list-push "test-perm" mem-get call
0 list 4 list-push 3 list-push 1 list-push 2 list-push "test-perm" mem-get call
0 list 4 list-push 3 list-push 2 list-push 1 list-push "test-perm" mem-get call

"Tested all 24 permutations:" print
"  Passed: " print "passed" mem-get to-text print
"  Failed: " print "failed" mem-get to-text print
"" print

"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
"RESULTS" print
"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" print
"" print

"╔═════════╦═══════════════╦═══════════╦═══════════════════════════╗" print
"║ Network ║ Comparators   ║ Tests     ║ Status                    ║" print
"╠═════════╬═══════════════╬═══════════╬═══════════════════════════╣" print
"passed" mem-get 24 eq
[ "║ Sort-4  ║ 5 (optimal)   ║ 24/24     ║ VERIFIED ✓               ║" print ]
[ "║ Sort-4  ║ 5 (optimal)   ║ FAILED    ║ CHECK ALGORITHM          ║" print ]
if
"╚═════════╩═══════════════╩═══════════╩═══════════════════════════╝" print
"" print

"Effect algebra insight:" print
"  - Every input gets exactly 5 CAS operations (effects)" print
"  - This is OPTIMAL (proven by Floyd 1964)" print
"" print

"SUCCESS: Sorting network verified!" print
