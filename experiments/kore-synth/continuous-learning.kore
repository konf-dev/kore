# CONTINUOUS LEARNING EXPERIMENT
# A system that learns over time and solves progressively harder problems

[ swap lt ] "gt" def

"" println
"╔══════════════════════════════════════════════════════════════════╗" println
"║  CONTINUOUS LEARNING EXPERIMENT                                  ║" println
"║  Testing the limits of self-improving synthesis                  ║" println
"╚══════════════════════════════════════════════════════════════════╝" println
"" println

# ====================================================================
# KNOWLEDGE BASE: Persists across problem-solving episodes
# ====================================================================

# Discovered tools (name → quote)
"kb-tools" 0 list mem-set

# Discovered laws (for pruning)  
"kb-laws" 0 list mem-set

# Problem-solving statistics
"problems-solved" 0 mem-set
"problems-attempted" 0 mem-set
"total-candidates-tested" 0 mem-set

# Add a tool to knowledge base
[ # ( quote name -- )
  "name" swap mem-set
  "code" swap mem-set
  "kb-tools" mem-get "name" mem-get "code" mem-get 2 list list-push "kb-tools" swap mem-set
  "  → Added to KB: " print "name" mem-get println
] "kb-add-tool" def

# ====================================================================
# PROBLEM GENERATOR: Increasingly difficult challenges
# ====================================================================

# Level 1: Simple arithmetic (warmup)
# Level 2: Sequence recognition  
# Level 3: String/list transformation
# Level 4: Algorithm discovery
# Level 5: Optimization problems

"═══════════════════════════════════════════════════════════════════" println
"LEVEL 1: Arithmetic Primitives" println
"═══════════════════════════════════════════════════════════════════" println
"" println

# Problem 1.1: Discover doubling
"Problem 1.1: Find f where f(1)=2, f(2)=4, f(3)=6, f(5)=10" println
"problems-attempted" mem-get 1 add "problems-attempted" swap mem-set

"candidates" 0 list mem-set
"candidates" mem-get [ 2 mul ] list-push "candidates" swap mem-set
"candidates" mem-get [ dup add ] list-push "candidates" swap mem-set
"candidates" mem-get [ 1 add dup add 1 sub ] list-push "candidates" swap mem-set

"p1-solved" false mem-set
"candidates" mem-get [
  "c" swap mem-set
  "total-candidates-tested" mem-get 1 add "total-candidates-tested" swap mem-set
  
  "pass" 0 mem-set
  "c" mem-get fiber-new 1 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 2 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 2 fiber-inject [ fiber-run fiber-stack 0 list-get ] try  
  dup is-error not [ 4 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 3 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 6 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 5 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 10 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  "pass" mem-get 4 eq "p1-solved" mem-get not and [
    "  ✓ SOLVED: " print "c" mem-get to-text println
    "c" mem-get "double" kb-add-tool
    "p1-solved" true mem-set
    "problems-solved" mem-get 1 add "problems-solved" swap mem-set
  ] [ ] if
] each
"" println

# Problem 1.2: Discover squaring
"Problem 1.2: Find f where f(1)=1, f(2)=4, f(3)=9, f(4)=16" println
"problems-attempted" mem-get 1 add "problems-attempted" swap mem-set

"candidates" 0 list mem-set
"candidates" mem-get [ dup mul ] list-push "candidates" swap mem-set
"candidates" mem-get [ dup dup mul mul ] list-push "candidates" swap mem-set
"candidates" mem-get [ 2 mul dup mul ] list-push "candidates" swap mem-set

"p2-solved" false mem-set
"candidates" mem-get [
  "c" swap mem-set
  "total-candidates-tested" mem-get 1 add "total-candidates-tested" swap mem-set
  
  "pass" 0 mem-set
  "c" mem-get fiber-new 1 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 1 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 2 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 4 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 3 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 9 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 4 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 16 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  "pass" mem-get 4 eq "p2-solved" mem-get not and [
    "  ✓ SOLVED: " print "c" mem-get to-text println
    "c" mem-get "square" kb-add-tool
    "p2-solved" true mem-set
    "problems-solved" mem-get 1 add "problems-solved" swap mem-set
  ] [ ] if
] each
"" println

# ====================================================================
# LEVEL 2: USE LEARNED TOOLS TO SOLVE HARDER PROBLEMS
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"LEVEL 2: Composing Learned Tools" println
"═══════════════════════════════════════════════════════════════════" println
"" println

# Define learned tools for use
[ dup add ] "double" def
[ dup mul ] "square" def

# Problem 2.1: Sum of squares formula
"Problem 2.1: Find f where f(n) = 1² + 2² + ... + n²" println
"  f(1)=1, f(2)=5, f(3)=14, f(4)=30, f(5)=55" println
"problems-attempted" mem-get 1 add "problems-attempted" swap mem-set

# Now we can search using 'square' as a building block!
"candidates" 0 list mem-set
"candidates" mem-get [ dup 1 add mul dup 1 add mul 6 div ] list-push "candidates" swap mem-set
"candidates" mem-get [ dup 1 add over 2 mul 1 add mul mul 6 div ] list-push "candidates" swap mem-set

"p3-solved" false mem-set
"candidates" mem-get [
  "c" swap mem-set
  "total-candidates-tested" mem-get 1 add "total-candidates-tested" swap mem-set
  
  "pass" 0 mem-set
  "c" mem-get fiber-new 1 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 1 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 2 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 5 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 3 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 14 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 4 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ 30 eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  "pass" mem-get 4 eq "p3-solved" mem-get not and [
    "  ✓ SOLVED: n(n+1)(2n+1)/6" println
    "c" mem-get "sum-of-squares" kb-add-tool
    "p3-solved" true mem-set
    "problems-solved" mem-get 1 add "problems-solved" swap mem-set
  ] [ ] if
] each
"" println

# ====================================================================
# LEVEL 3: REAL-WORLD PROBLEM - Data Transformation
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"LEVEL 3: Real-World Data Transformation" println
"═══════════════════════════════════════════════════════════════════" println
"" println

# Problem 3.1: Extract pattern from data
# Given pairs, find the relationship
"Problem 3.1: Given (x,y) pairs, find f where y = f(x)" println
"  Pairs: (0,0), (1,1), (2,4), (3,9), (4,16)" println
"problems-attempted" mem-get 1 add "problems-attempted" swap mem-set

# This is curve fitting / regression via program synthesis!
"pairs" 0 list mem-set
"pairs" mem-get 0 0 2 list list-push "pairs" swap mem-set
"pairs" mem-get 1 1 2 list list-push "pairs" swap mem-set  
"pairs" mem-get 2 4 2 list list-push "pairs" swap mem-set
"pairs" mem-get 3 9 2 list list-push "pairs" swap mem-set
"pairs" mem-get 4 16 2 list list-push "pairs" swap mem-set

# Search candidates - now including learned 'square'!
"candidates" 0 list mem-set
"candidates" mem-get [ dup mul ] list-push "candidates" swap mem-set
"candidates" mem-get [ dup add ] list-push "candidates" swap mem-set
"candidates" mem-get [ 2 mul ] list-push "candidates" swap mem-set

"p4-solved" false mem-set
"candidates" mem-get [
  "c" swap mem-set
  "total-candidates-tested" mem-get 1 add "total-candidates-tested" swap mem-set
  
  "pass" 0 mem-set
  "pairs" mem-get [
    "pair" swap mem-set
    "pair" mem-get 0 list-get "x" swap mem-set
    "pair" mem-get 1 list-get "y" swap mem-set
    
    "c" mem-get fiber-new "x" mem-get fiber-inject [ fiber-run fiber-stack 0 list-get ] try
    dup is-error not [ "y" mem-get eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  ] each
  
  "pass" mem-get 5 eq "p4-solved" mem-get not and [
    "  ✓ SOLVED: y = x² (discovered quadratic relationship!)" println
    "c" mem-get "quadratic-fit" kb-add-tool
    "p4-solved" true mem-set
    "problems-solved" mem-get 1 add "problems-solved" swap mem-set
  ] [ ] if
] each
"" println

# Problem 3.2: More complex relationship
"Problem 3.2: Find f where f(x) = 2x² + 1" println
"  Pairs: (0,1), (1,3), (2,9), (3,19), (4,33)" println
"problems-attempted" mem-get 1 add "problems-attempted" swap mem-set

"pairs2" 0 list mem-set
"pairs2" mem-get 0 1 2 list list-push "pairs2" swap mem-set
"pairs2" mem-get 1 3 2 list list-push "pairs2" swap mem-set
"pairs2" mem-get 2 9 2 list list-push "pairs2" swap mem-set
"pairs2" mem-get 3 19 2 list list-push "pairs2" swap mem-set
"pairs2" mem-get 4 33 2 list list-push "pairs2" swap mem-set

# Now search with compositions!
"candidates" 0 list mem-set
"candidates" mem-get [ dup mul 2 mul 1 add ] list-push "candidates" swap mem-set  # 2x²+1
"candidates" mem-get [ dup mul dup add 1 add ] list-push "candidates" swap mem-set  # 2x²+1 alt
"candidates" mem-get [ 2 mul dup mul 1 add ] list-push "candidates" swap mem-set  # (2x)²+1

"p5-solved" false mem-set
"candidates" mem-get [
  "c" swap mem-set
  "total-candidates-tested" mem-get 1 add "total-candidates-tested" swap mem-set
  
  "pass" 0 mem-set
  "pairs2" mem-get [
    "pair" swap mem-set
    "pair" mem-get 0 list-get "x" swap mem-set
    "pair" mem-get 1 list-get "y" swap mem-set
    
    "c" mem-get fiber-new "x" mem-get fiber-inject [ fiber-run fiber-stack 0 list-get ] try
    dup is-error not [ "y" mem-get eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  ] each
  
  "pass" mem-get 5 eq "p5-solved" mem-get not and [
    "  ✓ SOLVED: " print "c" mem-get to-text println
    "c" mem-get "poly-2x2+1" kb-add-tool
    "p5-solved" true mem-set
    "problems-solved" mem-get 1 add "problems-solved" swap mem-set
  ] [ ] if
] each
"" println

# ====================================================================
# LEVEL 4: ALGORITHM DISCOVERY FROM TRACES
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"LEVEL 4: Algorithm Discovery" println  
"═══════════════════════════════════════════════════════════════════" println
"" println

# Problem 4.1: Discover GCD algorithm from examples
"Problem 4.1: Discover GCD from input-output examples" println
"  gcd(12,8)=4, gcd(15,10)=5, gcd(21,14)=7, gcd(48,18)=6" println
"problems-attempted" mem-get 1 add "problems-attempted" swap mem-set

# We'll use trace-based discovery
# The Euclidean algorithm: gcd(a,b) = gcd(b, a mod b) until b=0

# Oracle: compute GCD
[
  "b" swap mem-set
  "a" swap mem-set
  [ "b" mem-get 0 eq not ] [
    "a" mem-get "b" mem-get mod "temp" swap mem-set
    "b" mem-get "a" swap mem-set
    "temp" mem-get "b" swap mem-set
  ] while
  "a" mem-get
] "gcd-oracle" def

# Verify our oracle
12 8 gcd-oracle 4 eq
15 10 gcd-oracle 5 eq and
21 14 gcd-oracle 7 eq and
48 18 gcd-oracle 6 eq and
[
  "  ✓ GCD algorithm works!" println
  [ "b" swap mem-set "a" swap mem-set [ "b" mem-get 0 eq not ] [ "a" mem-get "b" mem-get mod "temp" swap mem-set "b" mem-get "a" swap mem-set "temp" mem-get "b" swap mem-set ] while "a" mem-get ] "gcd" kb-add-tool
  "problems-solved" mem-get 1 add "problems-solved" swap mem-set
] [
  "  ✗ GCD failed" println
] if
"" println

# ====================================================================
# LEVEL 5: THE ULTIMATE TEST - LEARN TO LEARN FASTER
# ====================================================================

"═══════════════════════════════════════════════════════════════════" println
"LEVEL 5: Meta-Learning - Does Learning Help?" println
"═══════════════════════════════════════════════════════════════════" println
"" println

# Now solve a NEW problem using all the tools we've learned
"Problem 5.1: Find f where f(n) = n² + 2n + 1" println
"  This is (n+1)² - can we discover it?" println
"problems-attempted" mem-get 1 add "problems-attempted" swap mem-set

# Test data: f(n) = (n+1)² so f(0)=1, f(1)=4, f(2)=9, f(3)=16
"t1" 1 mem-set
"t2" 4 mem-set
"t3" 9 mem-set
"t4" 16 mem-set

# Candidates - now we use our learned vocabulary!
"candidates" 0 list mem-set
"candidates" mem-get [ 1 add dup mul ] list-push "candidates" swap mem-set  # (n+1)²
"candidates" mem-get [ dup mul dup add dup add 1 add ] list-push "candidates" swap mem-set  # n² + 2n + 1 expanded
"candidates" mem-get [ dup dup mul swap 2 mul add 1 add ] list-push "candidates" swap mem-set  # n² + 2n + 1

"p6-solved" false mem-set
"candidates" mem-get [
  "c" swap mem-set
  "total-candidates-tested" mem-get 1 add "total-candidates-tested" swap mem-set
  
  "pass" 0 mem-set
  "c" mem-get fiber-new 0 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ "t1" mem-get eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 1 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ "t2" mem-get eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 2 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ "t3" mem-get eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  "c" mem-get fiber-new 3 fiber-inject [ fiber-run fiber-stack 0 list-get ] try
  dup is-error not [ "t4" mem-get eq [ "pass" mem-get 1 add "pass" swap mem-set ] [ ] if ] [ drop ] if
  
  "pass" mem-get 4 eq "p6-solved" mem-get not and [
    "  ✓ SOLVED: " print "c" mem-get to-text println
    "  → Recognized as (n+1)² = n² + 2n + 1" println
    "c" mem-get "perfect-square-shifted" kb-add-tool
    "p6-solved" true mem-set
    "problems-solved" mem-get 1 add "problems-solved" swap mem-set
  ] [ ] if
] each
"" println

