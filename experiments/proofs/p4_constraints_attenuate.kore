-- ================================================================
-- PROOF: P4 — Constraints Attenuate
-- ================================================================
--
-- Claim: Constraints can only become MORE restrictive, never less.
--        Types form a lattice. Information flows upward.
--        You can narrow, never widen.
-- ================================================================

: check-error is-error swap drop ;

-- ————————————————————————————————————————
-- Lemma 1: The type lattice exists
-- ————————————————————————————————————————

-- Every value has a definite type. type-of is total.
: lemma1
  42 type-of swap drop "int" =
  3.14 type-of swap drop "float" = and
  true type-of swap drop "bool" = and
  "hi" type-of swap drop "str" = and
  ( 1 2 ) type-of swap drop "list" = and
  [ dup ] type-of swap drop "quote" = and
;

-- ————————————————————————————————————————
-- Lemma 2: Type narrowing (attenuation in action)
-- ————————————————————————————————————————

-- You can narrow from unknown to specific. Once narrowed, it holds.
: safe-double
  ->x x type-of swap drop "int" = if
    x dup +
  else
    0
  end
;

: lemma2
  42 safe-double 84 =          -- int: doubled
  "hi" safe-double 0 = and    -- non-int: rejected → 0
;

-- ————————————————————————————————————————
-- Lemma 3: Error containment (capability attenuation)
-- ————————————————————————————————————————

-- try blocks are one-way valves: errors in, values out
: lemma3
  [ 10 0 / ] try check-error       -- error stays contained
  [ 10 2 / ] try 5 = and           -- normal value passes through
;

-- ————————————————————————————————————————
-- Lemma 4: Propagation respects boundaries
-- ————————————————————————————————————————

: might-fail
  ->n n 0 = if 1 0 / else n end
;

: uses-fail
  ->n [ n might-fail ? 100 + ] try
;

: lemma4
  0 uses-fail check-error          -- error: ? fires, try catches
  5 uses-fail 105 = and            -- normal: ? passes, 5+100=105
;

-- ————————————————————————————————————————
-- Lemma 5: Higher-order tools preserve contracts
-- ————————————————————————————————————————

-- map preserves: if f: Int→Int, then map(f): [Int]→[Int]
: lemma5
  ( 1 2 3 ) [ 10 * ] map ->tens
  tens 0 get type-of swap drop "int" =
  tens 1 get type-of swap drop "int" = and
  tens 2 get type-of swap drop "int" = and
;

-- ————————————————————————————————————————
-- Lemma 6: Fold preserves accumulator type
-- ————————————————————————————————————————

: lemma6
  ( 1 2 3 4 5 ) 0 [ + ] fold   -- 15
  type-of swap drop "int" =    -- still int!
;

-- ————————————————————————————————————————
-- Theorem: Constraints Attenuate
-- ————————————————————————————————————————

lemma1 lemma2 and lemma3 and lemma4 and lemma5 and lemma6 and

-- Stack: true
-- QED: Constraints only tighten, never loosen.
-- Types form a lattice. Error containment is monotonic.
-- Higher-order tools preserve type contracts.
