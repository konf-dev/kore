-- ================================================================
-- PROOF: P3 — Composition = Concatenation
-- ================================================================
--
-- Claim: (f ; g)(S) = g(f(S))
--        The program "f g" (textual concatenation) IS composition.
--        No hidden control flow. The syntax IS the semantics.
-- ================================================================

: f 1 + ;
: g 2 * ;
: h 3 - ;

-- ————————————————————————————————————————
-- Lemma 1: Scalar composition = concatenation
-- ————————————————————————————————————————

: lemma1
  5 f g             -- f;g on 5 = (5+1)*2 = 12
  5 1 + 2 *         -- inline concatenation = 12
  =                 -- true: textual concat = composition
;

-- ————————————————————————————————————————
-- Lemma 2: Composition is associative
-- ————————————————————————————————————————

: lemma2
  5 f g h             -- ((5+1)*2)-3 = 9
  5 f [ g h ] apply   -- f ; (g;h) on 5 = 9
  =
;

-- ————————————————————————————————————————
-- Lemma 3: List operations compose by concatenation
-- ————————————————————————————————————————

-- dot product = zip ∘ [unpair *] map ∘ 0 [+] fold
: dot zip [ unpair * ] map 0 [ + ] fold ;

: lemma3
  ( 1 2 3 ) ( 4 5 6 ) dot  -- 1*4 + 2*5 + 3*6 = 32
  32 =
;

-- ————————————————————————————————————————
-- Lemma 4: No hidden state — deterministic
-- ————————————————————————————————————————

: sum-of-squares [ dup * ] map 0 [ + ] fold ;

: lemma4
  ( 2 3 4 ) sum-of-squares   -- 4+9+16 = 29
  ( 2 3 4 ) sum-of-squares   -- 29 again (same input → same output)
  =
;

-- ————————————————————————————————————————
-- Lemma 5: Functor law — map preserves composition
-- ————————————————————————————————————————

-- map(f ∘ g) = map(f) ∘ map(g)

: lemma5
  ( 1 2 3 ) [ 1 + 2 * ] map      -- map the composition: [4, 6, 8]
  ->lhs
  ( 1 2 3 ) [ 1 + ] map [ 2 * ] map  -- compose the maps: [4, 6, 8]
  ->rhs
  lhs 0 get rhs 0 get =
  lhs 1 get rhs 1 get = and
  lhs 2 get rhs 2 get = and
;

-- ————————————————————————————————————————
-- Lemma 6: Fold universality
-- ————————————————————————————————————————

: lemma6
  ( 1 2 3 4 5 ) 0 [ + ] fold 15 =      -- sum
  ( 1 2 3 4 5 ) 1 [ * ] fold 120 = and  -- product
  ( 10 20 30 40 ) 0 [ drop 1 + ] fold 4 = and  -- length via fold
;

-- ————————————————————————————————————————
-- Theorem: Composition = Concatenation
-- ————————————————————————————————————————

lemma1 lemma2 and lemma3 and lemma4 and lemma5 and lemma6 and

-- Stack: true
-- QED: Textual concatenation IS composition.
-- map(f∘g) = map(f)∘map(g) — List is a functor.
