# Kore World Configuration
# Copy this to .env and fill in your values

# =============================================================================
# LLM API Keys (at least one required for agent mode)
# =============================================================================

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI (or compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# =============================================================================
# Agent Configuration
# =============================================================================

# The goal for the autonomous agent
KORE_GOAL=Build a Kore world: start by writing a tokenizer, then a parser, then build useful tools

# =============================================================================
# Resource Limits (optional)
# =============================================================================

# These are set in docker-compose.yml but can be overridden
# MEMORY_LIMIT=8G
# CPU_LIMIT=4
